{
  "name": "@saplings/observability",
  "version": "0.0.0",
  "description": "Structured backend logs, OpenTelemetry helpers, and Node.js process metrics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@types/node": "^26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snrakshith/saplings.git",
    "directory": "packages/observability"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
