{
  "name": "@sapling/frontend-quality",
  "version": "0.17.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser-observability.d.ts",
      "default": "./dist/browser-observability.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "dependencies": {
    "@sapling/quality-core": "workspace:*",
    "playwright": "1.56.1",
    "@axe-core/playwright": "^4.10.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "@sapling/quality-browser-runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19.2.0"
  },
  "files": [
    "dist"
  ]
