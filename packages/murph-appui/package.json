{
  "name": "@saplings/murph-appui",
  "version": "0.17.2",
  "description": "Murphi design language rendered as React Native components",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "react-native": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@saplings/ui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": ">=0.88.0 <0.90.0"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "@types/react": "^19.3.0",
    "react-native": "^0.88.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snrakshith/saplings.git",
    "directory": "packages/murph-appui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
