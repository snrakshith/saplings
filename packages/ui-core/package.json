{
  "name": "@sapling/ui-core",
  "version": "0.17.0",
  "description": "Platform-independent Murphi design tokens and responsive design language",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "ATTRIBUTION.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  }
}
