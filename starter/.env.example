AWS_REGION=us-east-1
S3_BUCKET=
S3_KMS_KEY_ID=
STARTER_NOTIFICATIONS=off
SES_FROM=
VALKEY_URL=
CASHFREE_ENVIRONMENT=
CASHFREE_CLIENT_ID=
