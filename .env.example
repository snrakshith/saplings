# Preferred gateway (sandbox until production approval). Server-side only.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
# Alternatives
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Gateway & Realm platform v0.13.0 (never commit actual values)
SAPLING_REALM_RSA_PRIVATE_KEY_REF=
SAPLING_REALM_RSA_PUBLIC_KEY_REF=
SAPLING_REALM_ARGON2_PEPPER_REF=
SAPLING_IDENTITY_BASE_URL=https://auth.example.com
SAPLING_GATEWAY_TLS_CERT_REF=
SAPLING_GATEWAY_TLS_KEY_REF=
SAPLING_IDENTITY_STORE_URL=
SAPLING_GATEWAY_REDIS_URL=
