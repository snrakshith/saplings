{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Saplings",
  "description": "Build, test, and operate multi-tenant applications with Saplings.",
  "colors": {
    "primary": "#0E7557",
    "light": "#64DBA9",
